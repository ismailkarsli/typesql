{
  "name": "@typesql/prisma",
  "version": "0.1.5",
  "description": "Use a Prisma schema as a TypeSQL schema: convert the generated client's types, or generate an exact schema with the typesql-prisma generator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailkarsli/typesql.git",
    "directory": "packages/prisma"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/api.d.ts",
      "default": "./dist/generator/api.js"
    }
  },
  "bin": {
    "typesql-prisma": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fixtures": "prisma generate --schema test/fixtures/schema.prisma --generator client --no-hints",
    "typecheck": "pnpm run fixtures && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@typesql/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=7"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.4"
  },
  "homepage": "https://typesql.karsli.net/adapters/prisma",
  "bugs": {
    "url": "https://github.com/ismailkarsli/typesql/issues"
  },
  "author": "İsmail Karslı",
  "keywords": [
    "sql",
    "postgres",
    "postgresql",
    "typescript",
    "type-safe",
    "type-level",
    "raw-sql",
    "no-codegen",
    "prisma",
    "prisma-generator",
    "orm"
  ]
}
